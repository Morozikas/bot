# =====================================================
# BYBIT FUTURES ELITE SIGNAL ENGINE
# Скопируйте этот файл в .env и заполните значения
# cp config.env .env
# =====================================================

# ---- Bybit API ----
BYBIT_API_KEY=               # Ключ с bybit.com → API → Создать ключ
BYBIT_API_SECRET=            # Секрет (показывается один раз при создании)
BYBIT_TESTNET=false          # true для тестовой сети
BYBIT_RATE_LIMIT=30          # req/min (10-100). Безопасно: 20-40
BYBIT_REQUEST_DELAY_MS=500   # задержка между запросами в мс

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=          # Токен от @BotFather → /newbot
TELEGRAM_CHAT_ID=            # ID канала/группы (начинается с -100...)
TELEGRAM_EXTRA_CHATS=        # Доп. каналы через запятую (опционально)

# ---- Прокси (рекомендуется при банах Bybit) ----
# PROXY_URL=socks5://user:pass@ip:port

# ---- Логирование ----
LOG_LEVEL=INFO               # DEBUG | INFO | WARN | ERROR

# ---- Мониторинг HTTP ----
APP_PORT=8080

# ---- База данных и Redis (опционально) ----
DATABASE_URL=
REDIS_URL=

# =====================================================
# ТАЙМИНГИ СКАНИРОВАНИЯ
# =====================================================

SCAN_INTERVAL_SEC=600        # Полный скан каждые N сек (рек. 300-900)
CANDLES_5M_INTERVAL_SEC=300  # Обновление 5M свечей
CANDLES_15M_INTERVAL_SEC=900 # Обновление 15M свечей
DERIVATIVES_INTERVAL_SEC=30  # OI + Funding

# =====================================================
# СКАНИРОВАНИЕ РЫНКА
# =====================================================

TOP_COINS_LIMIT=100          # Ранжировать N монет (1 REST вызов)
ANALYSIS_LIMIT=15            # Глубокий анализ топ-N монет
WORKER_COUNT=3               # Параллельных воркеров (1-4)

# =====================================================
# ПОРОГИ КАЧЕСТВА СИГНАЛОВ
# =====================================================

MIN_SCORE_PUBLISH=90
MIN_SCORE_APLUS=95
MIN_SCORE_A=90
MIN_SCORE_B=85
MIN_RR=3.0
MIN_PROBABILITY=85

# =====================================================
# ВЕСА СКОРИНГА (сумма = 1.0)
# =====================================================

WEIGHT_LIQUIDITY=0.30
WEIGHT_STRUCTURE=0.25
WEIGHT_FVGOB=0.15
WEIGHT_OI=0.15
WEIGHT_VOLUME=0.15

# =====================================================
# ФИЛЬТРЫ
# =====================================================

MIN_VOLUME_RATIO=1.0         # Мин. объём / MA20

OB_MIN_FRESHNESS=1.0         # 1.0 = только нетронутый OB
OB_MIN_VOLUME_STRENGTH=1.5   # Объём OB > 1.5 среднего
OB_MAX_RETEST_COUNT=0        # Ноль ретестов

# =====================================================
# РЕЖИМ ТОРГОВЛИ
# =====================================================

TRADE_MODE=both              # intraday | swing | both
TP_COUNT=2                   # Тейков (1-3)

TRADE_MANAGEMENT=true
BREAKEVEN_AT_RR=1.0          # SL в BE при RR 1:1
NOTIFY_ON_TP=true
NOTIFY_ON_SL=true
NOTIFY_ON_BE=true

PENDING_ZONE_CHECK_SEC=15    # Проверка зон каждые N сек
PENDING_ZONE_MAX_AGE_SEC=7200

# =====================================================
# АВТОТОРГОВЛЯ
# =====================================================

TRADING_ENABLED=false

USER_1_ID=user1
USER_1_NAME=
USER_1_API_KEY=              # API ключ пользователя 1
USER_1_API_SECRET=
USER_1_TESTNET=false
USER_1_RISK_PCT=1.0          # % капитала на сделку
USER_1_MAX_LEVERAGE=10
USER_1_MAX_POSITIONS=5
USER_1_MIN_SCORE=92
USER_1_ACTIVE=true

USER_2_ID=user2
USER_2_NAME=
USER_2_API_KEY=
USER_2_API_SECRET=
USER_2_TESTNET=false
USER_2_RISK_PCT=0.5
USER_2_MAX_LEVERAGE=5
USER_2_MAX_POSITIONS=3
USER_2_MIN_SCORE=95
USER_2_ACTIVE=true

# USER_3_ ... USER_10_ — по аналогии
